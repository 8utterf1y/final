# Copy this file to .env in the project root.
# mini-claude auto-loads that .env on startup.
# Existing shell environment variables still win over values in .env.

# Core chat model
MINI_CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Anthropic format
ANTHROPIC_API_KEY=sk-ant-...
# Optional: Anthropic-compatible relay endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible format
# OPENAI_API_KEY=sk-openai-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: dedicated embedding config for /kb knowledge indexing.
# If omitted, embeddings fall back to OPENAI_API_KEY and OPENAI_BASE_URL.
MINI_KB_EMBEDDING_API_KEY=sk-embedding-...
MINI_KB_EMBEDDING_BASE_URL=https://api.openai.com/v1
MINI_KB_EMBEDDING_MODEL=text-embedding-3-small
# Only set this if your provider supports explicit dimensions.
MINI_KB_EMBEDDING_DIMENSIONS=1536
MINI_KB_EMBEDDING_BATCH_SIZE=32

# Optional chunking controls. Changing these requires `/kb reindex all`.
MINI_KB_CHUNK_TARGET_TOKENS=500
MINI_KB_CHUNK_OVERLAP_TOKENS=60

# Vector retrieval: auto uses HNSW for large unfiltered indexes when hnswlib
# is installed, otherwise it falls back to exact cosine search.
MINI_KB_VECTOR_INDEX=auto
MINI_KB_HNSW_MIN_CHUNKS=5000
MINI_KB_HNSW_M=16
MINI_KB_HNSW_EF_CONSTRUCTION=200
MINI_KB_HNSW_EF_SEARCH=64
